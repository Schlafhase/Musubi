{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "musubi",
  "rules": {
    "document": {
      "type": "FIELD",
      "name": "expression",
      "content": {
        "type": "SYMBOL",
        "name": "expression"
      }
    },
    "expression": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_atom"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_atom"
            }
          }
        ]
      }
    },
    "_atom": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "lambda"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "stringLiteral"
        },
        {
          "type": "SYMBOL",
          "name": "charLiteral"
        },
        {
          "type": "SYMBOL",
          "name": "numberLiteral"
        },
        {
          "type": "SYMBOL",
          "name": "letin"
        },
        {
          "type": "SYMBOL",
          "name": "paren"
        }
      ]
    },
    "paren": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "letin": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "let"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "definition"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": ","
                  },
                  {
                    "type": "SYMBOL",
                    "name": "definition"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ","
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "in"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "lambda": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\\"
            },
            {
              "type": "STRING",
              "value": "λ"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "."
            },
            {
              "type": "STRING",
              "value": "->"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "infixKeyword"
                },
                {
                  "type": "SYMBOL",
                  "name": "nonEncodedNumberLiteral"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "STRING",
          "value": ":="
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "infixKeyword": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "infix"
        },
        {
          "type": "STRING",
          "value": "infixl"
        },
        {
          "type": "STRING",
          "value": "infixr"
        }
      ]
    },
    "stringLiteral": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "escapeSequence"
              },
              {
                "type": "SYMBOL",
                "name": "stringSegment"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "escapeSequence": {
      "type": "PATTERN",
      "value": "\\\\."
    },
    "stringSegment": {
      "type": "PATTERN",
      "value": "[^\"\\\\\\n]+"
    },
    "charLiteral": {
      "type": "PATTERN",
      "value": "'(\\\\[\\\\nt']|.)'"
    },
    "numberLiteral": {
      "type": "PATTERN",
      "value": "\\d+[csb]?"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[^\\sλ\\(\\)\\.\\\\;,'\"0-9][^\\sλ\\(\\)\\.\\\\;,]*"
    },
    "nonEncodedNumberLiteral": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "macro": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#define"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "PATTERN",
          "value": "[^\\n]*"
        }
      ]
    },
    "once": {
      "type": "STRING",
      "value": "#once"
    },
    "comment": {
      "type": "PATTERN",
      "value": ";[^\\n]*"
    },
    "include": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#include"
        },
        {
          "type": "PATTERN",
          "value": "[A-Za-z0-9_.\\-\\/~]+"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "SYMBOL",
      "name": "macro"
    },
    {
      "type": "SYMBOL",
      "name": "once"
    },
    {
      "type": "SYMBOL",
      "name": "include"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}